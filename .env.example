# ==============================================================
# Travel App Environment Variables
# Copy this file to .env and update the values
# ==============================================================

# PostgreSQL Database Configuration
POSTGRES_DB=travel_db
POSTGRES_USER=danish
POSTGRES_PASSWORD=danish_secure_pass

# Database Connection (used by web service)
DB_HOST=travel-db
DB_PORT=5432

# Host Port Mappings
HOST_PORT=8085
ADMINER_PORT=8086

# Docker Image Configuration
DOCKER_USER=danishdopsa
APP_TAG=latest

